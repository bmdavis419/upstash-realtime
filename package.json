{
  "name": "@upstash/realtime",
  "version": "1.0.0",
  "author": "Joscha Neske",
  "repository": {
    "type": "git",
    "url": "https://github.com/upstash/realtime"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "turbo": "^2.6.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.5",
  "access": "public",
  "description": "An HTTP-based realtime client powered by Redis Streams.",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/upstash/realtime",
  "keywords": [
    "realtime",
    "serverless",
    "upstash"
  ],
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf node_modules .turbo packages/*/node_modules packages/*/.turbo apps/*/node_modules apps/*/.turbo",
    "build": "tsup",
    "lint": "tsc"
  }
}
